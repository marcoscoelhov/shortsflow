[Unit]
Description=ShortsFlow YouTube Analytics performance collection for %i
After=network-online.target tailscaled.service shortsflow-%i.service
Wants=network-online.target tailscaled.service

[Service]
Type=oneshot
User=shortsflow-%i
Group=shortsflow-%i
WorkingDirectory=/srv/shortsflow/%i
Environment=PYTHONPATH=/opt/shortsflow/%i/current
EnvironmentFile=/etc/shortsflow/%i.env
EnvironmentFile=/etc/shortsflow/%i-release.env
Environment=SHORTSFLOW_RUNTIME_ENVIRONMENT=%i
ExecStart=/opt/shortsflow/%i/current/.venv/bin/python -m app.cli analytics-sync-run
UMask=0027
NoNewPrivileges=true
PrivateTmp=true
