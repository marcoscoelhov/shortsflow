# Copie este arquivo para .env e preencha apenas o necessario para seu ambiente.
# Nunca versionar o .env real: ele pode conter tokens, chaves e credenciais OAuth.
# Booleanos usam true/false; duracoes e timeouts usam segundos, salvo indicacao.
# Variaveis comentadas mostram overrides opcionais e mantem o padrao da aplicacao.

# -----------------------------------------------------------------------------
# Hub e acesso
# -----------------------------------------------------------------------------
SHORTSFLOW_APP_NAME=ShortsFlow
# URL publica usada em links e callbacks. Host e porta controlam o bind local.
SHORTSFLOW_APP_URL=http://127.0.0.1:8080
SHORTSFLOW_APP_HOST=127.0.0.1
SHORTSFLOW_APP_PORT=8080
# Se preenchido, protege o Hub. Use um valor longo, aleatorio e exclusivo.
SHORTSFLOW_HUB_AUTH_TOKEN=
# Identidade do runtime e URLs usadas pelos comandos de controle remoto.
SHORTSFLOW_RUNTIME_ENVIRONMENT=development
SHORTSFLOW_DEPLOYMENT_REVISION=development
SHORTSFLOW_REMOTE_PRODUCTION_URL=https://srv769897.tailc97b69.ts.net
SHORTSFLOW_REMOTE_STAGING_URL=https://srv769897.tailc97b69.ts.net:8443

# -----------------------------------------------------------------------------
# Persistencia local
# -----------------------------------------------------------------------------
# Mantenha o diretorio e a URL SQLite apontando para o mesmo ambiente.
SHORTSFLOW_DATA_DIR=data
SHORTSFLOW_DATABASE_URL=sqlite:///data/shortsflow.db
# Deploys criam este arquivo para drenar o worker antes da troca atomica.
SHORTSFLOW_RUNTIME_DRAIN_PATH=data/runtime-drain
# Ativado apenas nos runtimes da VPS.
SHORTSFLOW_HEAVY_JOB_LOCK_ENABLED=false
SHORTSFLOW_HEAVY_JOB_LOCK_PATH=data/heavy-job.lock
SHORTSFLOW_STAGING_MIN_FREE_DISK_GB=15
SHORTSFLOW_STAGING_MIN_AVAILABLE_MEMORY_GB=2
SHORTSFLOW_STAGING_MAX_ARTIFACTS_GB=5

# -----------------------------------------------------------------------------
# Gates de qualidade, render e verificacao visual
# -----------------------------------------------------------------------------
# Auditoria final premium antes de aprovar/agendar/publicar.
# Juiz LLM para gates editoriais (viral, metadata, visual, growth) em zona cinza.
SHORTSFLOW_LLM_GATE_JUDGE_ENABLED=true
SHORTSFLOW_LLM_GATE_JUDGE_PROVIDER=xai
SHORTSFLOW_LLM_GATE_JUDGE_MODEL=grok-4.5
SHORTSFLOW_LLM_GATE_JUDGE_TIMEOUT_SEC=120
SHORTSFLOW_LLM_PREMIUM_REVIEW_ENABLED=true
SHORTSFLOW_LLM_PREMIUM_REVIEW_PROVIDER=deepseek
SHORTSFLOW_LLM_PREMIUM_REVIEW_MODEL=deepseek-v4-pro
SHORTSFLOW_LLM_JSON_MAX_TOKENS=4096
# Orçamento de saída do lote único de 10 pautas (automatic_topic): maior que o JSON normal.
SHORTSFLOW_LLM_TOPIC_BATCH_MAX_TOKENS=12000
SHORTSFLOW_LLM_GATE_GRAY_ZONE_LOW=0.72
SHORTSFLOW_LLM_GATE_GRAY_ZONE_HIGH=0.82
# Render principal operacional.
# Viralidade é uma métrica de crescimento; por padrão, roteiros factualmente
# seguros seguem para revisão mesmo abaixo da meta. Ative o bloqueio estrito
# somente quando a operação quiser rejeitar antes de renderizar.
SHORTSFLOW_VIRAL_INTENSITY_HARD_BLOCK=false
SHORTSFLOW_VIRAL_INTENSITY_MIN_SCORE=0.72
SHORTSFLOW_VIRAL_INTENSITY_MIN_HOOK_SCROLL_STOP=0.72
SHORTSFLOW_VIRAL_INTENSITY_MIN_CURIOSITY_GAP=0.68
SHORTSFLOW_VIRAL_INTENSITY_MIN_ESCALATION=0.62
SHORTSFLOW_VIRAL_INTENSITY_MIN_PAYOFF_SURPRISE=0.50
SHORTSFLOW_VIRAL_INTENSITY_MIN_SHARE_TRIGGER=0.45
# A revisao visual de publicacao e humana.
SHORTSFLOW_VISION_VERIFIER_PROVIDER=disabled

# -----------------------------------------------------------------------------
# Roteamento e credenciais de LLM
# -----------------------------------------------------------------------------
# Politica operacional: GPT-5.6 Luna max gera pauta, roteiro e cenas de
# contingencia; o rascunho primario de microdrama e DeepSeek V4 Flash high.
# Repair usa o mesmo Luna com reasoning.effort=max (luna-max).
# Grok 4.5 (papel xai via OpenCode Go, /responses) julga os gates. DeepSeek v4
# Pro faz revisao premium. Todos os LLM textuais passam por
# https://opencode.ai/zen/go/v1 via assinatura OpenCode Go.
SHORTSFLOW_LLM_PRIMARY_PROVIDER=openai
SHORTSFLOW_LLM_SCRIPT_DRAFT_PROVIDER=deepseek
# Rascunhos usam high no DeepSeek V4 Flash; juiz Grok e repair Luna mantêm high/max.
SHORTSFLOW_LLM_SCRIPT_REASONING_EFFORT=high
SHORTSFLOW_LLM_REPAIR_PROVIDER=openai
SHORTSFLOW_LLM_REPAIR_MODEL=gpt-5.6-luna
SHORTSFLOW_LLM_REPAIR_REASONING_EFFORT=max
SHORTSFLOW_LLM_REPAIR_TIMEOUT_SEC=360
SHORTSFLOW_LLM_SCENE_PROVIDER=openai
SHORTSFLOW_LLM_FALLBACK_PROVIDER=deepseek
SHORTSFLOW_LLM_ENABLE_FALLBACK=true
# Chave da conta OpenCode Go; o adapter OpenAI-compatible usa /responses.
SHORTSFLOW_OPENAI_API_KEY=
SHORTSFLOW_OPENAI_BASE_URL=https://opencode.ai/zen/go/v1
SHORTSFLOW_OPENAI_MODEL=gpt-5.6-luna
SHORTSFLOW_OPENAI_REASONING_EFFORT=max
SHORTSFLOW_LLM_TOPIC_TIMEOUT_SEC=150
SHORTSFLOW_LLM_SCRIPT_DRAFT_TIMEOUT_SEC=150
# Microdramas geram três trilhas completas em paralelo antes da seleção independente.
SHORTSFLOW_MICRODRAMA_SCRIPT_TRACK_COUNT=3
SHORTSFLOW_MICRODRAMA_SCRIPT_GENERATION_PARALLELISM=4
# JSON de 100-150s + métricas, limitado para evitar respostas vazias e timeouts longos.
SHORTSFLOW_MICRODRAMA_SCRIPT_MAX_TOKENS=4096
SHORTSFLOW_DEEPSEEK_API_KEY=
SHORTSFLOW_DEEPSEEK_BASE_URL=https://opencode.ai/zen/go/v1
SHORTSFLOW_DEEPSEEK_MODEL=deepseek-v4-flash
SHORTSFLOW_XAI_API_KEY=
SHORTSFLOW_XAI_BASE_URL=https://opencode.ai/zen/go/v1
SHORTSFLOW_XAI_MODEL=grok-4.5
SHORTSFLOW_XAI_REASONING_EFFORT=high
SHORTSFLOW_XAI_TIMEOUT_SEC=180

# -----------------------------------------------------------------------------
# MiniMax, texto, imagens e musica
# -----------------------------------------------------------------------------
# SHORTSFLOW_MINIMAX_API_KEY e um fallback compartilhado. Prefira chaves separadas.
SHORTSFLOW_MINIMAX_API_KEY=
SHORTSFLOW_MINIMAX_TEXT_API_KEY=
SHORTSFLOW_MINIMAX_IMAGE_API_KEY=
SHORTSFLOW_MINIMAX_MUSIC_API_KEY=
SHORTSFLOW_MINIMAX_TEXT_MODEL=MiniMax-M2.7
SHORTSFLOW_MINIMAX_TEXT_THINKING=auto

# -----------------------------------------------------------------------------
# Narracao (TTS)
# -----------------------------------------------------------------------------
# Gemini usa SHORTSFLOW_GEMINI_API_KEY como fallback quando a chave dedicada nao existe.
SHORTSFLOW_TTS_PRIMARY_PROVIDER=gemini_tts
SHORTSFLOW_GEMINI_API_KEY=
# SHORTSFLOW_GEMINI_TTS_API_KEY=
# SHORTSFLOW_GEMINI_TTS_MODEL=gemini-3.1-flash-tts-preview
# SHORTSFLOW_GEMINI_TTS_VOICE_NAME=Kore
# SHORTSFLOW_GEMINI_TTS_VOICE_ROTATION_ENABLED=true
# SHORTSFLOW_GEMINI_TTS_STYLE_PROMPT=Narre em portugues brasileiro natural, com ritmo humano de documentario curto, sem soar sintetico ou robotico.
SHORTSFLOW_ELEVENLABS_API_KEY=
# SHORTSFLOW_ELEVENLABS_VOICE_ID=JBFqnCBsd6RMkjVDRZzb
# SHORTSFLOW_ELEVENLABS_MODEL_ID=eleven_multilingual_v2

# -----------------------------------------------------------------------------
# Publicacao no YouTube
# -----------------------------------------------------------------------------
# O callback vazio e derivado de SHORTSFLOW_APP_URL. Credenciais nao habilitam a
# publicacao sozinhas; modo e automacao sao controlados pelo Hub.
SHORTSFLOW_YOUTUBE_CHANNEL_ID=
SHORTSFLOW_YOUTUBE_CLIENT_ID=
SHORTSFLOW_YOUTUBE_CLIENT_SECRET=
SHORTSFLOW_YOUTUBE_OAUTH_REDIRECT_URI=
# Perfil de canal (opcional): separa token/state OAuth entre canais.
# Ex.: SHORTSFLOW_YOUTUBE_CHANNEL_PROFILE=canal2 e
#      SHORTSFLOW_YOUTUBE_CHANNEL_PROFILE_CHANNEL_ID=UCalgo
SHORTSFLOW_YOUTUBE_CHANNEL_PROFILE=
SHORTSFLOW_YOUTUBE_CHANNEL_PROFILE_CHANNEL_ID=

# -----------------------------------------------------------------------------
# Publicacao no TikTok
# -----------------------------------------------------------------------------
# Token manual com escopo video.publish. O Hub nao renova esse token.
SHORTSFLOW_TIKTOK_ACCESS_TOKEN=
# SHORTSFLOW_TIKTOK_AUTO_PUBLISH_ENABLED=false
# SHORTSFLOW_TIKTOK_PRIVACY_LEVEL=PUBLIC_TO_EVERYONE
# SHORTSFLOW_TIKTOK_RETROPOST_DAILY_LIMIT=1

# -----------------------------------------------------------------------------
# Bancos de assets externos, opcionais
# -----------------------------------------------------------------------------
SHORTSFLOW_PEXELS_API_KEY=
SHORTSFLOW_PIXABAY_API_KEY=

# -----------------------------------------------------------------------------
# Exposicao via Tailscale
# -----------------------------------------------------------------------------
SHORTSFLOW_TAILSCALE_HOSTNAME=shorts-hub
SHORTSFLOW_TAILNET_DOMAIN=example.ts.net

# -----------------------------------------------------------------------------
# Overrides avancados de infraestrutura ou SDK
# -----------------------------------------------------------------------------
# Normalmente nao e preciso descomentar. Prefira o Hub para escolher LLM,
# musica, automacao e modo de publicacao.
# SHORTSFLOW_OPENAI_MODEL=gpt-5.4-nano
# SHORTSFLOW_GEMINI_TEXT_MODEL=gemini-3.5-flash
# SHORTSFLOW_GEMINI_TEXT_TIMEOUT_SEC=180
# SHORTSFLOW_MINIMAX_TEXT_BASE_URL=https://api.minimax.io/v1
# SHORTSFLOW_MINIMAX_IMAGE_BASE_URL=https://api.minimax.io/v1/image_generation
# SHORTSFLOW_MINIMAX_IMAGE_ASPECT_RATIO=9:16
# SHORTSFLOW_MINIMAX_MUSIC_BASE_URL=https://api.minimax.io/v1
